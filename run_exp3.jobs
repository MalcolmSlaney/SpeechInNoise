# A list of jobs for exp3 shell, each line consists of an experiment name (tag)
# and then a list of offline_line_asr parameters

tiny.en	--model=tiny.en
tiny	--model=tiny
base.en	--model=base.en
base	--model=base
small.en	--model=small.en
small	--model=small
medium.en	--model=medium.en
medium	--model=medium
large	--model=large

large_prime  --model=large --use_prime 
large_prompt  --model=large --use_prompt 

large_forced_-10  --model=large --use_forced --oov_penalty=-10
large_forced_0  --model=large --use_forced --oov_penalty=0
large_forced_10  --model=large --use_forced --oov_penalty=10
large_forced_20  --model=large --use_forced --oov_penalty=20
large_forced_100  --model=large --use_forced --oov_penalty=100

large_exact_-10  --model=large --use_exact --oov_penalty=-10
large_exact_0  --model=large --use_exact --oov_penalty=0
large_exact_10  --model=large --use_exact --oov_penalty=10
large_exact_20  --model=large --use_exact --oov_penalty=20
large_exact_100  --model=large --use_exact --oov_penalty=100